install.packages(c(
"here", "readxl", "dplyr", "tidyr", "ggplot2"
))
source("E:/uga course/workexample1/code/01_data_preparation.R", echo=TRUE)
install.packages(
"vctrs",
repos = "https://cloud.r-project.org"
)
packageVersion("vctrs")
library(dplyr)
R.version.string
.libPaths()
find.package("vctrs")
packageVersion("vctrs")
# Create a personal package library.
r_series <- paste(
R.version$major,
strsplit(R.version$minor, ".", fixed = TRUE)[[1]][1],
sep = "."
)
user_lib <- file.path(
Sys.getenv("LOCALAPPDATA"),
"R",
"win-library",
r_series
)
dir.create(
user_lib,
recursive = TRUE,
showWarnings = FALSE
)
.libPaths(c(user_lib, .libPaths()))
# Install matching Windows binary packages.
install.packages(
c("vctrs", "dplyr"),
lib = user_lib,
repos = "https://cloud.r-project.org",
type = "binary"
)
r_series <- paste(
R.version$major,
strsplit(R.version$minor, ".", fixed = TRUE)[[1]][1],
sep = "."
)
user_lib <- file.path(
Sys.getenv("LOCALAPPDATA"),
"R",
"win-library",
r_series
)
.libPaths(c(user_lib, .libPaths()))
find.package("vctrs")
packageVersion("vctrs")
packageVersion("dplyr")
library(dplyr)
